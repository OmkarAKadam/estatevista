# EstateVista V2 backend — local environment template.
#
# Copy this file to backend/.env for your own reference, then export the values
# into your shell before starting the application. backend/.env is ignored by
# Git. NEVER put real credentials in this example file or in any tracked file.
#
# PowerShell example:
#   $env:DB_PASSWORD = "your-local-password"
#   $env:SPRING_PROFILES_ACTIVE = "dev"

# --- Runtime -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- PostgreSQL --------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/estatevista
DB_USERNAME=estatevista
DB_PASSWORD=change-me-local-only
DB_POOL_SIZE=10

# --- CORS / WebSocket --------------------------------------------------------
# Comma-separated, exact origins. Never use "*" with credentials.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
APP_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Session cookie ----------------------------------------------------------
# Must be true in production (HTTPS). Local HTTP development uses false.
SESSION_COOKIE_SECURE=false

# --- Forwarded headers -------------------------------------------------------
# none locally; set to native behind Render's trusted proxy.
FORWARD_HEADERS_STRATEGY=none

# --- Email provider (reserved placeholder; not wired in Stage 1.8) -----------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=example@example.com
MAIL_PASSWORD=replace-me
MAIL_FROM=no-reply@example.com

# --- Cloudinary (reserved placeholder; not wired in Stage 1.8) ---------------
CLOUDINARY_CLOUD_NAME=example-cloud
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
